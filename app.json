{
  "expo": {
    "name": "Infinity-Arthvishva-HRMS",
    "slug": "Infinity-Arthvishva-HRMS",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "infinityarthvishvahrms",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/ic_launcher_foreground.png",
        "backgroundImage": "./src/assets/images/ic_launcher_background.png",
        "monochromeImage": "./src/assets/images/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shasak.InfinityArthvishvaHRMS",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./src/assets/images/splash.png",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification_icon.png",
          "color": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-camera",
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
